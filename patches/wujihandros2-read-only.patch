index 0000000..4df2ef5
--- /dev/null
+++ b/wujihand_bringup/launch/wujihand_read_only.launch.py
@@ -0,0 +1,106 @@
+"""Strictly read-only real-hand RViz bringup for the local Wuji Hand.
+
+This launch always passes read_only=True to the official driver. It has no
+joint command subscriber and no enable/disable/reset service, so it can be
+used as the first hardware validation gate without sending actuator writes.
+"""
+
+import os
+import sys
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, OpaqueFunction, TimerAction
+from launch.conditions import IfCondition
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+from launch_ros.parameter_descriptions import ParameterValue
+
+sys.path.insert(0, os.path.dirname(__file__))
+from common import detect_handedness, spawn_robot_state_publisher
+
+
+def spawn_rviz(context):
+    """Start RViz after the read-only driver has reported physical handedness."""
+    hand_name = LaunchConfiguration("hand_name").perform(context)
+    hand_type = detect_handedness(hand_name)
+    if hand_type is None:
+        return []
+
+    description_dir = get_package_share_directory("wuji_description")
+    rviz_config = os.path.join(description_dir, "rviz", f"{hand_type}.rviz")
+    return [
+        Node(
+            package="rviz2",
+            executable="rviz2",
+            name="rviz2",
+            namespace=hand_name,
+            arguments=["-d", rviz_config],
+            output="screen",
+        )
+    ]
+
+
+def generate_launch_description():
+    hand_name_arg = DeclareLaunchArgument(
+        "hand_name", default_value="hand_0", description="Namespace for this hand"
+    )
+    serial_number_arg = DeclareLaunchArgument(
+        "serial_number",
+        default_value="336636733434",
+        description="Expected Wuji Hand serial number; override only for another hand",
+    )
+    hand_side_arg = DeclareLaunchArgument(
+        "hand_side",
+        default_value="",
+        description="Optional physical side selector when no serial number is supplied",
+    )
+    publish_rate_arg = DeclareLaunchArgument(
+        "publish_rate",
+        default_value="100.0",
+        description="Read-only joint-state publish rate in Hz",
+    )
+    rviz_arg = DeclareLaunchArgument(
+        "rviz", default_value="true", description="Start RViz2"
+    )
+
+    driver = Node(
+        package="wujihand_driver",
+        executable="wujihand_driver_node",
+        name="wujihand_driver",
+        namespace=LaunchConfiguration("hand_name"),
+        parameters=[
+            {
+                "serial_number": ParameterValue(
+                    LaunchConfiguration("serial_number"), value_type=str
+                ),
+                "hand_side": ParameterValue(LaunchConfiguration("hand_side"), value_type=str),
+                "read_only": True,
+                "publish_rate": LaunchConfiguration("publish_rate"),
+            }
+        ],
+        output="screen",
+        emulate_tty=True,
+    )
+
+    robot_state_publisher = TimerAction(
+        period=2.0, actions=[OpaqueFunction(function=spawn_robot_state_publisher)]
+    )
+    rviz = TimerAction(
+        period=2.5,
+        actions=[OpaqueFunction(function=spawn_rviz)],
+        condition=IfCondition(LaunchConfiguration("rviz")),
+    )
+
+    return LaunchDescription(
+        [
+            hand_name_arg,
+            serial_number_arg,
+            hand_side_arg,
+            publish_rate_arg,
+            rviz_arg,
+            driver,
+            robot_state_publisher,
+            rviz,
+        ]
+    )
